# 本地复制为 .env.local；Vercel 在项目 Environment Variables 中配置。
# Vercel 原生函数必须禁用会提前读取请求体的 helpers。
# vercel.json 已在构建环境中设置；此项也适用于 Vercel CLI 本地开发。
NODEJS_HELPERS=0

# 留空表示不限制客户端。支持 IPv4、IPv6 和 CIDR，逗号分隔。
ALLOWED_CLIENT_IPS=
# 例如：203.0.113.10,198.51.100.0/24,2001:db8::/32

# 可选代理密钥；客户端使用 X-Proxy-Token，Authorization 留给目标 API。
PROXY_TOKEN=

# 留空允许任意公网目标。支持精确域名和 *.example.com（不包含根域）。
ALLOWED_TARGET_HOSTS=
# 例如：openrouter.ai,api.openai.com,*.example.com

# 默认阻止内网、回环、链路本地及其他非公网 IP；本地测试可设 true。
ALLOW_PRIVATE_TARGETS=false

# 总时长涵盖上传、等待和响应流；必须小于 vercel.json 的 maxDuration。
REQUEST_TIMEOUT_MS=290000
# DNS、TCP、TLS 建连超时。
CONNECT_TIMEOUT_MS=10000
# 已建连后的空闲超时；0 表示不单独限制，仍受总时长约束。
UPSTREAM_IDLE_TIMEOUT_MS=0

# 请求体上限；0 表示应用不限制，但仍受 Vercel 平台限制。
MAX_REQUEST_BODY_BYTES=4500000
CORS_MAX_AGE_SECONDS=86400

# 仅本地开发服务器使用。
HOST=127.0.0.1
PORT=3000
